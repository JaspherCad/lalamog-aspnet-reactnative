# Copy to .env and choose strong local passwords before the first Compose start.
# Preserve existing .env values when containers already have persisted data.
# Compose and the Development API both read infrastructure/.env; no launcher is required.
# Non-secret API defaults live in appsettings.Development.json.
# Use literal KEY=value lines, optional matching outer quotes, and full-line comments.
# The API does not expand variables or inline comments; avoid interpolation syntax.
MSSQL_SA_PASSWORD=replace-with-a-strong-local-password
RABBITMQ_USER=lalamog
RABBITMQ_PASSWORD=replace-with-a-random-password
SEED_DEMO=true
DEMO_PASSWORD=replace-with-a-strong-demo-password
